<?xml version="1.0"?>
<Definitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<CubeBlocks>
		<Definition xsi:type="MyObjectBuilder_ShipDrillDefinition">
			<Id>
				<TypeId>Drill</TypeId>
				<SubtypeId>BasicStaticDrill</SubtypeId>
			</Id>
			<DisplayName>Basic Static Drill</DisplayName>
			<Icon>Textures\BasicStaticDrill.dds</Icon>
			<Description>Place this drill atop a ore deposit and power it to start mining ore</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="2" y="3" z="1"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Center x="0" y="0" z="0"/>
			<Model>Models\BasicDrill\StaticDrill.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="100"/>
				<Component Subtype="Construction" Count="30"/>
				<Component Subtype="LargeTube" Count="10"/>
				<Component Subtype="Computer" Count="5"/>
				<Component Subtype="Motor" Count="50"/>
				<Component Subtype="SteelPlate" Count="10"/>
			</Components>
			<CriticalComponent Subtype="Computer" Index="0"/>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.05" EndX="2.00" EndY="0.38"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.05" EndX="2.00" EndY="0.38"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.05" EndX="1.00" EndY="0.38"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.04" EndX="1.00" EndY="0.99"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="2.00" EndY="1.00"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\BasicDrill\StaticDrill_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\BasicDrill\StaticDrill_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\BasicDrill\StaticDrill_BS3.mwm"/>
			</BuildProgressModels>
			<MirroringX>Y</MirroringX>
			<MirroringY>X</MirroringY>
			<PCU>100</PCU>
			<IsAirTight>false</IsAirTight>
			<BuildTimeSeconds>10</BuildTimeSeconds>
			<GuiVisible>false</GuiVisible>
			<IsPublic>false</IsPublic>
			<VoxelPlacement>
				<!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
				<StaticMode>
					<PlacementMode>Volumetric</PlacementMode>
					<MaxAllowed>0.6</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>Volumetric</PlacementMode>
					<MaxAllowed>0.6</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<ResourceSinkGroup>Factory</ResourceSinkGroup>
			<SensorRadius>0</SensorRadius>
			<SensorOffset>0</SensorOffset>
			<CutOutRadius>0</CutOutRadius>
			<CutOutOffset>0</CutOutOffset>
			<ParticleOffset>
				<X>0</X>
				<Y>0</Y>
				<Z>0</Z>
			</ParticleOffset>
			<DeformationRatio>0.2</DeformationRatio>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<PrimarySound>ToolShipDrillIdle</PrimarySound>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
		</Definition>
		<Definition xsi:type="MyObjectBuilder_ShipDrillDefinition">
			<Id>
				<TypeId>Drill</TypeId>
				<SubtypeId>StaticDrill</SubtypeId>
			</Id>
			<DisplayName>Static Drill</DisplayName>
			<Icon>Textures\StaticDrill.dds</Icon>
			<Description>Place this drill atop a ore deposit and power it to start mining ore</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="2" y="3" z="2"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Center x="0" y="0" z="0"/>
			<Model>Models\MediumDrill\StaticDrill.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="150"/>
				<Component Subtype="Construction" Count="50"/>
				<Component Subtype="LargeTube" Count="15"/>
				<Component Subtype="Computer" Count="10"/>
				<Component Subtype="Motor" Count="80"/>
				<Component Subtype="SteelPlate" Count="20"/>
			</Components>
			<CriticalComponent Subtype="Computer" Index="0"/>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.03" EndX="2.00" EndY="0.33"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.19" EndX="2.00" EndY="1.78"/>
				<MountPoint Side="Left" StartX="0.00" StartY="0.00" EndX="2.00" EndY="0.36"/>
				<MountPoint Side="Right" StartX="0.00" StartY="0.06" EndX="2.00" EndY="1.26"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="2.00" EndY="2.00"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\MediumDrill\StaticDrill_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\MediumDrill\StaticDrill_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\MediumDrill\StaticDrill_BS3.mwm"/>
			</BuildProgressModels>
			<MirroringX>Y</MirroringX>
			<MirroringY>X</MirroringY>
			<PCU>100</PCU>
			<IsAirTight>false</IsAirTight>
			<BuildTimeSeconds>20</BuildTimeSeconds>
			<GuiVisible>false</GuiVisible>
			<IsPublic>false</IsPublic>
			<VoxelPlacement>
				<!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
				<StaticMode>
					<PlacementMode>Volumetric</PlacementMode>
					<MaxAllowed>0.6</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>Volumetric</PlacementMode>
					<MaxAllowed>0.6</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<ResourceSinkGroup>Factory</ResourceSinkGroup>
			<SensorRadius>0</SensorRadius>
			<SensorOffset>0</SensorOffset>
			<CutOutRadius>0</CutOutRadius>
			<CutOutOffset>0</CutOutOffset>
			<ParticleOffset>
				<X>0</X>
				<Y>0</Y>
				<Z>0</Z>
			</ParticleOffset>
			<DeformationRatio>0.2</DeformationRatio>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<PrimarySound>ToolShipDrillIdle</PrimarySound>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
		</Definition>
		<Definition xsi:type="MyObjectBuilder_ShipDrillDefinition">
			<Id>
				<TypeId>Drill</TypeId>
				<SubtypeId>AdvancedStaticDrill</SubtypeId>
			</Id>
			<DisplayName>Advanced Static Drill</DisplayName>
			<Icon>Textures\AdvancedStaticDrill.dds</Icon>
			<Description>Place this drill atop a ore deposit and power it to start mining ore</Description>
			<CubeSize>Large</CubeSize>
			<BlockTopology>TriangleMesh</BlockTopology>
			<Size x="3" y="4" z="3"/>
			<ModelOffset x="0" y="0" z="0"/>
			<Center x="0" y="0" z="0"/>
			<Model>Models\AdvancedDrill\StaticDrill.mwm</Model>
			<Components>
				<Component Subtype="SteelPlate" Count="500"/>
				<Component Subtype="InteriorPlate" Count="20"/>
				<Component Subtype="MetalGrid" Count="50"/>
				<Component Subtype="Construction" Count="30"/>
				<Component Subtype="LargeTube" Count="30"/>
				<Component Subtype="Computer" Count="10"/>
				<Component Subtype="Motor" Count="100"/>
				<Component Subtype="SteelPlate" Count="10"/>
			</Components>
			<CriticalComponent Subtype="Computer" Index="0"/>
			<MountPoints>
				<MountPoint Side="Front" StartX="0.00" StartY="0.00" EndX="3.00" EndY="0.21"/>
				<MountPoint Side="Back" StartX="0.00" StartY="0.00" EndX="3.00" EndY="0.21"/>
				<MountPoint Side="Left" StartX="1.00" StartY="0.00" EndX="2.00" EndY="2.00"/>
				<MountPoint Side="Right" StartX="1.00" StartY="0.00" EndX="2.00" EndY="0.99"/>
				<MountPoint Side="Bottom" StartX="0.00" StartY="0.00" EndX="3.00" EndY="3.00"/>
			</MountPoints>
			<BuildProgressModels>
				<Model BuildPercentUpperBound="0.33" File="Models\AdvancedDrill\StaticDrill_BS1.mwm"/>
				<Model BuildPercentUpperBound="0.67" File="Models\AdvancedDrill\StaticDrill_BS2.mwm"/>
				<Model BuildPercentUpperBound="1.00" File="Models\AdvancedDrill\StaticDrill_BS3.mwm"/>
			</BuildProgressModels>
			<MirroringX>Y</MirroringX>
			<MirroringY>X</MirroringY>
			<PCU>100</PCU>
			<IsAirTight>false</IsAirTight>
			<BuildTimeSeconds>30</BuildTimeSeconds>
			<GuiVisible>false</GuiVisible>
			<IsPublic>false</IsPublic>
			<VoxelPlacement>
				<!--Possible settings Both,InVoxel,OutsideVoxel,Volumetric. If volumetric set than MaxAllowed and MinAllowed will be used.-->
				<StaticMode>
					<PlacementMode>Volumetric</PlacementMode>
					<MaxAllowed>0.6</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</StaticMode>
				<DynamicMode>
					<PlacementMode>Volumetric</PlacementMode>
					<MaxAllowed>0.6</MaxAllowed>
					<MinAllowed>0</MinAllowed>
				</DynamicMode>
			</VoxelPlacement>
			<ResourceSinkGroup>Factory</ResourceSinkGroup>
			<SensorRadius>0</SensorRadius>
			<SensorOffset>0</SensorOffset>
			<CutOutRadius>0</CutOutRadius>
			<CutOutOffset>0</CutOutOffset>
			<ParticleOffset>
				<X>0</X>
				<Y>0</Y>
				<Z>0</Z>
			</ParticleOffset>
			<DeformationRatio>0.2</DeformationRatio>
			<DamageEffectName>Damage_HeavyMech_Damaged</DamageEffectName>
			<DamagedSound>ParticleHeavyMech</DamagedSound>
			<PrimarySound>ToolShipDrillIdle</PrimarySound>
			<DestroyEffect>BlockDestroyedExplosion_Large</DestroyEffect>
			<DestroySound>WepSmallWarheadExpl</DestroySound>
		</Definition>
	</CubeBlocks>
</Definitions>
